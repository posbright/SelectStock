# ============================================================
# InStock 环境变量配置
# ============================================================
# 复制本文件为 .env 并根据需要修改。
# 优先级：系统环境变量 > .env 文件 > 代码默认值
# 未设置的变量将使用注释中标注的默认值。
# ============================================================

# ============ 数据库连接（必填） ============
db_host=127.0.0.1
db_user=root
db_password=your_password_here
db_database=instockdb
db_port=3306
# db_charset=utf8mb4

# ============ 数据库连接池 ============
# INSTOCK_DB_CONNECT_TIMEOUT=10      # 连接超时（秒）
# INSTOCK_DB_READ_TIMEOUT=30         # 读取超时（秒）
# INSTOCK_DB_WRITE_TIMEOUT=30        # 写入超时（秒）
# INSTOCK_DB_POOL_SIZE=2             # 连接池基础大小
# INSTOCK_DB_MAX_OVERFLOW=3          # 连接池最大溢出数
# INSTOCK_DB_POOL_RECYCLE=600        # 连接回收周期（秒）
# INSTOCK_DB_POOL_TIMEOUT=30         # 获取连接超时（秒）
# INSTOCK_DB_MAX_RETRIES=3           # 启动时数据库连接重试次数
# INSTOCK_DB_RETRY_DELAY=5           # 重试间隔（秒）

# ============ 数据源 ============
# DATA_SOURCE_MAX_RETRIES=2          # 单数据源最大重试次数
# DATA_SOURCE_RETRY_INTERVAL=90      # 重试基础间隔（秒，指数退避）
# HIST_DATA_DEFAULT_YEARS=10         # 默认获取历史数据年数（1-20）
# DATA_SOURCE_FAIL_THRESHOLD=5       # 连续失败多少次后降级该数据源
# DATA_SOURCE_COOLDOWN_SECONDS=300   # 数据源降级冷却时间（秒）
# DATA_SOURCE_MAX_COOLDOWN=3600      # 数据源最大冷却时间（秒）

# ============ 东方财富 ============
# EAST_MONEY_COOKIE=                 # 东方财富 Cookie（覆盖文件和默认值）
# INSTOCK_EM_RETRY=3                 # 东方财富 API 请求重试次数
# INSTOCK_EM_TIMEOUT=30              # 东方财富 API 请求超时（秒）

# ============ 代理池 ============
# INSTOCK_PROXY_VALIDATE_URL=http://datacenter.eastmoney.com/api/data/get
# INSTOCK_PROXY_VALIDATE_TIMEOUT=5   # 代理验证超时（秒）
# INSTOCK_PROXY_REFRESH_INTERVAL=600 # 代理池后台刷新间隔（秒）
# INSTOCK_PROXY_MIN_POOL_SIZE=3      # 代理池最小数量
# INSTOCK_PROXY_FETCH_WORKERS=50     # 代理验证并发线程数
# INSTOCK_PROXY_INIT_BATCH_SIZE=200  # 初始化时验证的候选代理数
# INSTOCK_PROXY_MAX_FAIL_COUNT=3     # 连续失败次数阈值，超过则移除
# INSTOCK_PROXY_STALE_SECONDS=600    # 代理验证结果过期时间（秒）
# INSTOCK_PROXY_CACHE_MAX_AGE=86400  # 代理磁盘缓存 TTL（秒）
# INSTOCK_PROXY_TARGET_POOL_SIZE=15  # 代理池目标数量
# INSTOCK_PROXY_EMERGENCY_COOLDOWN=30 # 紧急补充代理冷却时间（秒）

# ============ 作业控制 ============
# INSTOCK_FORCE_FETCH=0              # 强制获取数据（跳过新鲜度检查）
# INSTOCK_FORCE_ANALYSIS=0           # 强制执行分析（即使已完成）
# INSTOCK_FORCE_KLINE_CACHE=0        # 强制K线缓存更新（跳过依赖检查）
# INSTOCK_ANALYSIS_DONE_THRESHOLD=1000 # 分析完成判定：指标表行数阈值

# ============ 数据新鲜度阈值 ============
# INSTOCK_FRESH_STOCK_SPOT=3000      # cn_stock_spot 最低行数
# INSTOCK_FRESH_ETF_SPOT=200         # cn_etf_spot 最低行数
# INSTOCK_FRESH_SELECTION=100        # cn_stock_selection 最低行数
# INSTOCK_FRESH_FUND_FLOW=2000       # cn_stock_fund_flow 最低行数

# ============ 并发控制 ============
# INSTOCK_BATCH_SIZE=50              # 流式分析每批股票数
# INSTOCK_ANALYSIS_WORKERS=2         # 流式分析并发线程数
# INSTOCK_INDICATOR_WORKERS=4        # 指标计算并发线程数
# INSTOCK_KLINE_PATTERN_WORKERS=4    # K线形态识别并发线程数
# INSTOCK_STRATEGY_WORKERS=4         # 策略计算并发线程数（内层，按股票）
# INSTOCK_STRATEGY_OUTER_WORKERS=2   # 策略外层并发数（按策略表）
# INSTOCK_KLINE_CACHE_WORKERS=2      # K线缓存更新并发数
# INSTOCK_BACKTEST_OUTER_WORKERS=1   # 回测外层并发（按表）
# INSTOCK_BACKTEST_INNER_WORKERS=2   # 回测内层并发（按股票）
# INSTOCK_BATCH_DATE_WORKERS=3       # 批量日期作业并发数
# INSTOCK_CRAWL_WORKERS=5            # 数据爬取并发线程数（新浪/腾讯）
# INSTOCK_DB_CONN_RETRIES=3          # 数据库操作重试次数（get_connection/insert/executeSql）

# ============ 子进程超时 ============
# INSTOCK_JOB_TIMEOUT=1800           # 子进程默认超时（秒，默认 30 分钟）
# INSTOCK_KLINE_JOB_TIMEOUT=36000    # K线缓存子进程超时（秒，默认 10 小时）

# ============ 数据结算 ============
# INSTOCK_SETTLEMENT_HOUR=18         # API 数据结算时间（小时，默认 18）
                                     # A股收盘 15:00，但龙虎榜/大宗交易等数据延迟发布
                                     # 在此时间之前每次执行都会重新获取 API 数据
                                     # 在此时间之后若数据行数达标则跳过重复获取

# ============ 查询缓存 ============
# INSTOCK_CACHE_MAX_SIZE=512         # 股票数据查询缓存最大条目
# INSTOCK_CACHE_TTL=300              # 查询缓存 TTL（秒）
# INSTOCK_FILTER_CACHE_MAX_SIZE=128  # 策略筛选缓存最大条目
# INSTOCK_FILTER_CACHE_TTL=600       # 筛选缓存 TTL（秒）

# ============ Web 服务 ============
# INSTOCK_WEB_PORT=9988              # Tornado 监听端口

# ============ 日志 ============
# INSTOCK_LOG_MAX_BYTES=10485760     # 单个日志文件最大大小（字节，默认 10MB）
# INSTOCK_LOG_BACKUP_COUNT=5         # 日志轮转保留文件数

# ============ 交易 / 回测 ============
# INSTOCK_TURTLE_BALANCE=200000      # 海龟策略模拟资金
# INSTOCK_COMMISSION_RATE=0.00025    # 佣金率（单边，0.025%）
# INSTOCK_STAMP_TAX_RATE=0.0005     # 印花税（卖方，0.05%）
# INSTOCK_SLIPPAGE_RATE=0.0005      # 滑点率（单边，0.05%）

# ============ OOM 防护（低内存服务器） ============
# INSTOCK_STOP_SERVICES=nginx        # 内存密集型任务前停止的系统服务（空格分隔）
# INSTOCK_NO_SERVICE_STOP=0          # 设为 1 禁用自动停止/恢复服务
