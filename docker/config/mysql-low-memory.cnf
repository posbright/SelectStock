# ============================================================
# MySQL 低内存优化配置（适用于 1-2GB 内存服务器）
# ============================================================
# 将此文件放置于服务器 /etc/mysql/conf.d/ 或 Docker 挂载至
# /etc/mysql/conf.d/low-memory.cnf
#
# 目标：将 MySQL 内存占用控制在 300-400MB 以内
# 原默认配置约 854MB RSS → OOM-killer 杀进程
# ============================================================

[mysqld]
# ---- InnoDB 缓冲池（最大内存消耗项）----
# 默认 128MB，MySQL 8.0 实际可能分配更多
# 对于 InStock 场景（写多读少，读集中在单日数据），256MB 足够
innodb_buffer_pool_size = 256M

# 减少缓冲池实例数（小内存下减少碎片）
innodb_buffer_pool_instances = 1

# ---- InnoDB 日志 ----
# 默认 48MB×2 = 96MB，减少到 32MB
innodb_log_buffer_size = 8M
innodb_redo_log_capacity = 64M

# ---- 连接相关 ----
# InStock 最多 ~10 个并发连接
max_connections = 30

# 每连接缓冲区（默认值偏大，调小以减少总内存）
sort_buffer_size = 256K
read_buffer_size = 256K
read_rnd_buffer_size = 512K
join_buffer_size = 256K

# ---- 临时表 ----
tmp_table_size = 16M
max_heap_table_size = 16M

# ---- 查询缓存（MySQL 8.0 已移除，保留注释说明）----
# query_cache_size = 0  # MySQL 8.0 不再支持

# ---- 表缓存 ----
# InStock 约 50+ 张表
table_open_cache = 200
table_definition_cache = 200

# ---- 线程 ----
thread_cache_size = 8

# ---- Performance Schema（可选关闭以节省 ~100MB）----
# 如果不需要 MySQL 性能诊断，取消注释可进一步节省内存
# performance_schema = OFF

# ---- 安全设置 ----
# 防止单个查询消耗过多内存
max_allowed_packet = 16M
