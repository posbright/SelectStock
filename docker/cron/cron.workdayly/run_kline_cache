PROJECT_ROOT=/data/InStock
source /etc/cron/_common.sh

init_env
LOG_FILE=$LOG_DIR/workdayly.log

check_trade_day "K线缓存更新"
run_job "K线缓存增量更新 (kline_cache_daily_job)" "instock/job/kline_cache_daily_job.py"
