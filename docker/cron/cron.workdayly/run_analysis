#!/bin/bash

# 数据分析任务（独立，服务器回退模式）
# 只执行本地分析计算（指标/K线/策略/回测），不调用外部API
# 与 run_fetch 配合使用，实现获取与分析解耦
# 依赖 fetch 已更新的缓存，但即使缓存未更新也能用历史数据运行
#
# 本地优先模式：
#   - 分析任务已内置"跳过已完成"检查
#   - 如果本地计算机已执行完分析并写入DB，此脚本自动跳过
#   - 设置 INSTOCK_FORCE_ANALYSIS=1 可强制执行
#   - 阈值可通过 INSTOCK_ANALYSIS_DONE_THRESHOLD 调整（默认 1000）

# Docker 环境：项目固定在 /data/InStock
PROJECT_ROOT=/data/InStock

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH
export PYTHONIOENCODING=utf-8
export LANG=zh_CN.UTF-8
export PYTHONPATH=$PROJECT_ROOT
export LC_CTYPE=zh_CN.UTF-8

LOG_DIR=$PROJECT_ROOT/instock/log
mkdir -p $LOG_DIR
LOG_FILE=$LOG_DIR/workdayly.log

# 非交易日跳过
IS_TRADE_DAY=$(python3 -c "
import sys, os
sys.path.insert(0, '$PROJECT_ROOT')
try:
    import instock.lib.trade_time as trd
    print('1' if trd.is_trade_date() else '0')
except Exception:
    print('1')  # 检测失败时保守执行
" 2>/dev/null)

if [ "$IS_TRADE_DAY" = "0" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 非交易日，跳过数据分析任务" >> $LOG_FILE
    exit 0
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] 开始执行 analysis_daily_job（数据分析，自动检测跳过）" >> $LOG_FILE
python3 $PROJECT_ROOT/instock/job/analysis_daily_job.py >> $LOG_FILE 2>&1
EXIT_CODE=$?
if [ $EXIT_CODE -eq 0 ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 数据分析完成 (成功)" >> $LOG_FILE
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 数据分析完成 (失败, 退出码: $EXIT_CODE)" >> $LOG_FILE
fi
