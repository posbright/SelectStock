#!/bin/bash
# 完整每日任务 — 串行执行 fetch → kline_cache → analysis（Docker 版）
# 也可分别调度 run_fetch / run_kline_cache / run_analysis（推荐）
PROJECT_ROOT=/data/InStock
source /etc/cron/_common.sh

init_env
LOG_FILE=$LOG_DIR/workdayly.log

check_trade_day "每日任务"

OVERALL_START=$(date +%s)
log_info "============ 每日完整任务开始 ============"

FAILED=0
run_sub "Phase 1: 数据获取"    "/etc/cron.workdayly/run_fetch"       || FAILED=$((FAILED + 1))
run_sub "Phase 2: K线缓存更新" "/etc/cron.workdayly/run_kline_cache" || FAILED=$((FAILED + 1))
run_sub "Phase 3: 数据分析"    "/etc/cron.workdayly/run_analysis"    || FAILED=$((FAILED + 1))

OVERALL_DUR_STR=$(elapsed_fmt $(($(date +%s) - OVERALL_START)))

if [ $FAILED -eq 0 ]; then
    log_info "============ 每日完整任务结束 (全部成功, $OVERALL_DUR_STR) ============"
else
    log_warn "============ 每日完整任务结束 (${FAILED}/3 失败, $OVERALL_DUR_STR) ============"
fi