#!/bin/bash
# 月度清理任务 — 清理过期缓存数据（Docker 版）
# 用法: run_monthly [--all]  （--all 全量清除，默认智能清理）
PROJECT_ROOT=/data/InStock
source /etc/cron/_common.sh

init_env
LOG_FILE=$LOG_DIR/monthly.log

if [ "$1" = "--all" ]; then
    log_info "开始全量清除缓存"
    rm -rf "$PROJECT_ROOT/instock/cache/hist"/*
    log_info "已全量清除所有历史K线缓存"
else
    log_info "开始智能清理缓存"
    python3 -c "
import sys; sys.path.insert(0, '$PROJECT_ROOT')
from instock.core.stockfetch import clean_expired_cache
clean_expired_cache()
" >> "$LOG_FILE" 2>&1
    log_info "缓存清理完成"
fi
