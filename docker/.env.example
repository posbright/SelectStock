# InStock Docker 环境配置文件
# 复制此文件为 .env 并根据需要修改

# ============ 数据库配置 ============
DB_PASSWORD=root
DB_DATABASE=instockdb

# ============ 端口配置 ============
# Web服务端口
WEB_PORT=9988
# Supervisor管理端口
SUPERVISOR_PORT=9001

# ============ 数据源配置 ============
# 数据源最大重试次数
DATA_SOURCE_MAX_RETRIES=2
# 数据源重试间隔（秒）
DATA_SOURCE_RETRY_INTERVAL=30

# ============ 历史数据配置 ============
# 默认获取历史数据年数（1-20年）
HIST_DATA_DEFAULT_YEARS=15
# 缓存过期天数（超过此天数未更新的缓存将被清理）
HIST_DATA_CACHE_EXPIRE_DAYS=30

# ============ 远程数据库配置 ============
# 使用 docker-compose.remote-db.yml 时必须设置以下变量
# REMOTE_DB_HOST 和 REMOTE_DB_PASSWORD 为必填项
REMOTE_DB_HOST=your-db-host
REMOTE_DB_PORT=3306
REMOTE_DB_USER=root
REMOTE_DB_PASSWORD=your-password
REMOTE_DB_DATABASE=instockdb
