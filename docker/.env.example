# ============================================================
# InStock Docker 环境配置文件
# ============================================================
# 复制此文件为 .env 并根据需要修改
# 完整变量列表见项目根目录 .env.example
# ============================================================

# ============ 数据库配置 ============
DB_PASSWORD=root
DB_DATABASE=instockdb

# ============ 端口配置 ============
# Web服务端口
WEB_PORT=9988
# Supervisor管理端口
SUPERVISOR_PORT=9001

# ============ 数据源配置 ============
# DATA_SOURCE_MAX_RETRIES=2          # 数据源最大重试次数
# DATA_SOURCE_RETRY_INTERVAL=30      # 数据源重试间隔（秒）
# HIST_DATA_DEFAULT_YEARS=15         # 默认获取历史数据年数

# ============ 并发控制 ============
# INSTOCK_BATCH_SIZE=50              # 流式分析每批股票数
# INSTOCK_ANALYSIS_WORKERS=2         # 流式分析并发线程数
# INSTOCK_KLINE_CACHE_WORKERS=2      # K线缓存更新并发数
# INSTOCK_BACKTEST_OUTER_WORKERS=1   # 回测外层并发
# INSTOCK_BACKTEST_INNER_WORKERS=2   # 回测内层并发

# ============ 远程数据库配置 ============
# 使用 docker-compose.remote-db.yml 时必须设置以下变量
# REMOTE_DB_HOST 和 REMOTE_DB_PASSWORD 为必填项
REMOTE_DB_HOST=your-db-host
REMOTE_DB_PORT=3306
REMOTE_DB_USER=root
REMOTE_DB_PASSWORD=your-password
REMOTE_DB_DATABASE=instockdb
